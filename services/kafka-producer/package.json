    "kafkajs": "^2.2.4",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.17.0",
    "vitest": "^2.0.5",
    "@types/node": "^20.14.15",
    "@types/jsonwebtoken": "^9.0.6"
  }
}
