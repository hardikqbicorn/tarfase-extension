{
  "name": "@ide-collector/kafka-producer",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP ingestion service: authenticates installations, validates events, and produces them to Kafka idempotently.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
