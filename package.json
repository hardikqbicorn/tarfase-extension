{
  "name": "universal-ide-event-collector",
  "private": true,
  "version": "0.1.0",
  "description": "Universal IDE Event Collection Platform - collects developer activity across IDEs, normalizes it into one schema, ships it through Kafka, and persists it in Supabase/Postgres.",
  "workspaces": [
    "packages/*",
    "services/*",
    "extensions/vscode"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc -b packages/event-schema packages/crypto packages/shared-utils packages/event-sdk",
    "dev:api": "npm run dev -w services/api",
    "dev:producer": "npm run dev -w services/kafka-producer",
    "dev:consumer": "npm run dev -w services/kafka-consumer",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "@types/node": "^20.14.15",
    "zod": "^3.23.8",
    "uuid": "^9.0.1",
    "@types/uuid": "^9.0.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
