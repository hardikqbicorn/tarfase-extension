{
  "name": "universal-ide-event-collector",
  "private": true,
  "version": "0.1.0",
  "description": "Universal IDE Event Collection Platform - collects developer activity across IDEs, normalizes it into one schema, ships it through Kafka, and persists it in Supabase/Postgres.",
  "workspaces": [
    "packages/*",
    "services/*",
    "extensions/vscode",
    "cli"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc -b packages/event-schema packages/crypto packages/shared-utils packages/event-sdk",
    "dev:api": "npm run dev -w services/api",
    "dev:producer": "npm run dev -w services/kafka-producer",
    "dev:consumer": "npm run dev -w services/kafka-consumer",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v",
    "test:db": "./scripts/test-db.sh",
    "migrate": "tsx scripts/migrate.ts",
    "check:db": "tsx scripts/check-db.ts",
    "clean": "tsc -b --clean",
    "rebuild": "npm run clean && npm run build",
    "quickstart": "tsx scripts/quickstart.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^9.0.8",
    "pg": "^8.23.0",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4",
    "uuid": "^9.0.1",
    "vitest": "^2.0.5",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
