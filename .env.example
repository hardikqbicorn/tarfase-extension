# =============================================================================
# Environment configuration for the Universal IDE Event Collection Platform.
#
# Copy to `.env` and fill in. `.env` is gitignored - never commit real secrets.
#
# Default topology: Kafka in Docker, events persisted to Supabase.
#   docker compose up --build
# =============================================================================

# --- Database (Supabase) -------------------------------------------------------
#
# IMPORTANT: use the SESSION POOLER, not the direct connection.
#
# Supabase's direct host (db.<ref>.supabase.co) is IPv6-only unless you have
# the IPv4 add-on. Docker containers have no IPv6 by default, so the services
# cannot reach it even though psql works from your shell. The Session pooler
# is IPv4 and is the right target here.
#
# Get it from: Project Settings -> Database -> Connection string -> Session pooler
# Note the user is postgres.<project-ref>, not plain postgres.
#
# Percent-encode special characters in the password: @ -> %40, # -> %23,
# / -> %2F, : -> %3A.
#
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Direct connection (works only where IPv6 is available, e.g. your host shell):
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Local Postgres instead of Supabase (start it with: docker compose --profile local-db up):
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ide_events

# --- TLS ----------------------------------------------------------------------
#
# Supabase signs its database certificates with its own CA, which is NOT in the
# system trust store, so verification fails out of the box with
# "self-signed certificate in certificate chain". The connection is encrypted
# either way; the only question is whether the certificate is verified.
#
# Preferred fix - verify against Supabase's CA:
#   1. Dashboard -> Project Settings -> Database -> SSL configuration ->
#      Download certificate
#   2. Save it as certs/supabase-ca.crt   (gitignored)
#   3. Uncomment ONE of the lines below.
#
# For host commands (npm run migrate, npm run check:db):
# DATABASE_CA_CERT_FILE=./certs/supabase-ca.crt
#
# For the Dockerised services (certs/ is mounted at /app/certs):
# DATABASE_CA_CERT_FILE=/app/certs/supabase-ca.crt
#
# Inline instead of a file, for secret-injection deployments. Literal \n
# sequences are converted to real newlines:
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
#
# Quick unblock - encrypted but NOT verified. Prefer the CA above.
# DATABASE_SSL=require
#
# Other values: verify (default for remote hosts), disable (local only).

DATABASE_POOL_SIZE=10

# --- Shared -------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# Signs installation tokens. Issued by the API service, verified by the
# ingestion service, so BOTH must share the same value.
# Generate: openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret

# --- API service (port 8081) ---------------------------------------------------
# Guards operator endpoints: enrollment-code issuance, revocation, event query.
# Generate: openssl rand -hex 32
ADMIN_API_KEY=dev-admin-key

# Lets an extension register without an enrollment code. Development only -
# the service forces this to false when NODE_ENV=production.
ALLOW_OPEN_ENROLLMENT=true

# How long an issued installation token stays valid (seconds). Default 1 year.
TOKEN_TTL_SECONDS=31536000

# How long an enrollment code stays redeemable (seconds). Default 15 minutes.
ENROLLMENT_CODE_TTL_SECONDS=900

# --- Kafka (in Docker) ---------------------------------------------------------
# Service-to-service address inside the Compose network. From your host shell,
# Kafka is reachable at localhost:9092.
KAFKA_BROKERS=kafka:29092
KAFKA_TOPIC_RAW=ide.events.raw
KAFKA_TOPIC_PROCESSED=ide.events.processed
KAFKA_TOPIC_ERRORS=ide.events.errors
KAFKA_GROUP_ID=ide-events-persister

# TLS + SASL for any non-local broker. Not needed for the local Docker broker.
KAFKA_SSL=false
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# -1 = wait for all in-sync replicas before acknowledging. Do not lower this in
# production: it is what makes an accepted event durable.
KAFKA_ACKS=-1
KAFKA_RETRIES=8

# --- Ingestion service (port 8080) ---------------------------------------------
MAX_BATCH_EVENTS=1000
BODY_LIMIT_BYTES=5242880

# --- Consumer service (port 8082) ----------------------------------------------
WRITE_BATCH_SIZE=200
EMIT_PROCESSED_EVENTS=false
KAFKA_FROM_BEGINNING=true
